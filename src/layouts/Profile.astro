---
import Site from './Site.astro';
import Action from '../components/Action.astro';
import { portfolio, publicPhone, type Language } from '../site';
import { materials } from '../materials';

interface Props { lang: Language; }
const { lang } = Astro.props;
const es = lang === 'es';
const pending = [
  !portfolio.cv && (es ? 'CV pendiente de adjuntar.' : 'CV upload pending.'),
  !publicPhone && (es ? 'Número de contacto pendiente.' : 'Contact number pending.'),
].filter(Boolean).join(' ');
---
<Site lang={lang} page="profile"
  title={es ? 'Perfil profesional' : 'Professional profile'}
  description={es ? 'Trayectoria de Miss Daly como docente de inglés en educación secundaria.' : 'Miss Daly’s experience teaching English in secondary education.'}>
  <section class:list={['shell', 'hero', 'profile-hero', { 'has-portrait': portfolio.portrait }]}>
    <div class="hero-copy">
      <h1>{es ? 'Soy Miss Daly,' : 'I’m Miss Daly,'} <em>{es ? 'docente de inglés.' : 'an English teacher.'}</em></h1>
      <p class="intro">{es
        ? 'He enseñado inglés frente a grupo en primero y segundo de secundaria. Diseño actividades que ayudan a mis estudiantes a usar el idioma dentro y fuera del aula.'
        : 'I’ve taught English to first- and second-year secondary school classes. I design activities that help my students use English in and beyond the classroom.'}</p>
      <div class="actions">
        <Action blue href={portfolio.cv} download>{es ? 'Descargar CV en español' : 'Download CV in Spanish'}</Action>
        <Action href={publicPhone && `tel:${publicPhone}`}>{es ? 'Llamar' : 'Call'}</Action>
      </div>
      {pending && <p class="note">{pending}</p>}
    </div>
    <figure class="profile-portrait">
      <img src={portfolio.portrait} srcset={`${portfolio.portraitSmall} 640w, ${portfolio.portrait} 1122w`} sizes="(max-width: 700px) 20rem, 28rem" alt="Miss Daly" width="1122" height="1402" fetchpriority="high" decoding="async" />
    </figure>
  </section>

  <section class="profile-band">
    <div class="shell split-section">
      <h2>{es ? 'Experiencia docente' : 'Teaching experience'}</h2>
      <article class="record">
        <p class="date">2025–2026 · Toluca</p>
        <h3>{es ? 'Docente de inglés en secundaria' : 'Secondary school English teacher'}</h3>
        <p>{es
          ? 'Realicé evaluaciones diagnósticas, planeé e impartí clases y evalué el aprendizaje en primero y segundo grado. También participé en proyectos escolares para practicar y mostrar el inglés fuera del aula.'
          : 'I assessed students’ initial levels, planned and taught lessons, and evaluated learning in the first and second years of secondary school. I also contributed to school projects where students could use and showcase their English beyond the classroom.'}</p>
      </article>
    </div>
  </section>
  <section class="shell split-section">
    <h2>{es ? 'Formación' : 'Education'}</h2>
    <article class="record">
      <p class="date">2022–2026 · Normal No. 1 de Toluca</p>
      <h3>{es ? 'Licenciatura en Enseñanza y Aprendizaje del Inglés' : 'Bachelor’s degree in English Language Teaching and Learning'}</h3>
    </article>
  </section>
  <section class="shell split-section rule">
    <h2>{es ? 'Proyectos y materiales' : 'Projects and teaching materials'}</h2>
    <div>
      <p class="materials-intro">{es ? 'Una selección de fichas, evaluación y proyectos en PDF.' : 'A selection of worksheets, assessment and project materials in PDF.'}</p>
      <ul class="projects">
        {materials.map(material => (
          <li>
            <a class="material-link" href={encodeURI(`/trabajos/${material.file}`)} type="application/pdf" target="_blank" rel="noopener noreferrer">
              <span class="material-copy">
                <span class="material-title">{material.title[lang]}</span>
                <span class="material-description">{material.description[lang]}</span>
                <span class="material-meta">PDF · {material.pages} {es ? (material.pages === 1 ? 'página' : 'páginas') : (material.pages === 1 ? 'page' : 'pages')}</span>
              </span>
              <span class="material-open">{es ? 'Ver PDF' : 'View PDF'}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="note">{es ? 'Los PDF se abren en una pestaña nueva.' : 'PDFs open in a new tab.'}</p>
    </div>
  </section>
</Site>
